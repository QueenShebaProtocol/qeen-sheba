# Queen Sheba Environment Configuration
# Demonstration and Vulnerable Target Settings

PORT=8000
HOST=127.0.0.1

# When true, the application runs entirely locally with realistic mock AI responses
# without consuming external API tokens or needing provider credentials.
DEMO_MOCK_MODE=true

# LLM Provider Configuration (used when DEMO_MOCK_MODE=false)
# Supported providers: gemini, openai
LLM_PROVIDER=groq
LLM_API_KEY=YOUR_API_TOKEN
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.7

# Conversation History Limits (Token conservation)
MAX_HISTORY_MESSAGES=50
